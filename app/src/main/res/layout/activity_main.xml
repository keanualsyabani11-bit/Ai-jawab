<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#080F20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="#3D7FFF"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <TextView
                    android:text="AI EXAM"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Kerjakan semua soal otomatis"
                    android:textColor="#445577"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#0E1E3C"
            android:layout_marginBottom="20dp"/>

        <!-- Status bar -->
        <LinearLayout
            android:orientation="horizontal"
            android:background="#0A1428"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvStatusOverlay"
                android:text="Overlay: Belum diizinkan"
                android:textColor="#FF6B6B"
                android:textSize="10sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvStatusAccess"
                android:text="Auto-fill: Belum diizinkan"
                android:textColor="#FF6B6B"
                android:textSize="10sp"
                android:gravity="end"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Menu item 1: Jawab soal otomatis -->
        <LinearLayout
            android:id="@+id/btnJawabOtomatis"
            android:orientation="horizontal"
            android:background="@drawable/bg_menu_item"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:background="#3D7FFF"
                android:padding="8dp"
                android:layout_marginEnd="14dp"
                android:layout_width="38dp"
                android:layout_height="38dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="4dp"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="4dp"/>
                <View
                    android:layout_width="60%"
                    android:layout_height="2dp"
                    android:background="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <TextView
                    android:text="Jawab soal otomatis"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="Kerjakan semua soal"
                    android:textColor="#445577"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:text=">"
                android:textColor="#3D7FFF"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Menu item 2: Jawaban diisi AI -->
        <LinearLayout
            android:id="@+id/btnJawabanAI"
            android:orientation="horizontal"
            android:background="@drawable/bg_menu_item"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:background="#1A2744"
                android:padding="8dp"
                android:layout_marginEnd="14dp"
                android:gravity="center"
                android:layout_width="38dp"
                android:layout_height="38dp">
                <TextView
                    android:text="AI"
                    android:textColor="#3D7FFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <TextView
                    android:text="Jawaban diisi AI"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="Isi kolom jawaban"
                    android:textColor="#445577"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:text=">"
                android:textColor="#3D7FFF"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Menu item 3: Auto nilai di atas KKM -->
        <LinearLayout
            android:id="@+id/btnAutoNilai"
            android:orientation="horizontal"
            android:background="@drawable/bg_menu_item"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:background="#0A2010"
                android:padding="8dp"
                android:layout_marginEnd="14dp"
                android:gravity="center"
                android:layout_width="38dp"
                android:layout_height="38dp">
                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="#00D68F"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <TextView
                    android:text="Auto nilai di atas KKM"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:text="Target nilai lulus"
                    android:textColor="#445577"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:text=">"
                android:textColor="#3D7FFF"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Bantuan label -->
        <TextView
            android:text="BANTUAN"
            android:textColor="#2A3D60"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Stop button -->
        <TextView
            android:id="@+id/btnStop"
            android:text="MATIKAN OVERLAY"
            android:textColor="#FF4466"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#180810"
            android:padding="14dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
